{
  "family": "pipeline-matrix",
  "prompt": "Build code that evaluates, with PyTerrier, the following pipelines: BM25; BM25 >> PRF >> BM25; and BM25 scores injected into a BERT cross-encoder on MS MARCO dev, TREC DL19, TREC DL20 and NanoBEIR; and SPLADE; RetroMAE; SPLADE >> monoT5; RetroMAE >> monoT5; BM25 >> PRF >> SPLADE >> monoT5; BM25 >> ColBERT >> PRF >> ColBERT on NanoBEIR only. Reuse indexes and caches where you can, and test each pipeline for significance against BM25 with a Bonferroni correction.",
  "run_dir_rule": "runs/<slug>/<pipeline>.res.gz, slug = ir_datasets id with '/' replaced by '-', lower case (the same layout SuiteEval's save_dir writes)",
  "pipelines": [
    {
      "id": "bm25",
      "spec": "BM25 (Terrier, default k1/b), k=1000",
      "models": [],
      "weight": 1
    },
    {
      "id": "bm25_prf_bm25",
      "spec": "BM25 >> RM3 (fb_docs=3, fb_terms=10) >> BM25, k=1000",
      "models": [],
      "weight": 1
    },
    {
      "id": "splade",
      "spec": "SPLADE learned-sparse retrieval, k=1000",
      "models": [
        "naver/splade-cocondenser-ensembledistil"
      ],
      "weight": 8,
      "datasets": [
        "nanobeir"
      ]
    },
    {
      "id": "retromae",
      "spec": "RetroMAE dense retrieval (pyterrier_dr), k=1000",
      "models": [
        "Shitao/RetroMAE_MSMARCO_distill"
      ],
      "weight": 6,
      "datasets": [
        "nanobeir"
      ]
    },
    {
      "id": "splade_monot5",
      "spec": "SPLADE top-100 >> text >> monoT5",
      "models": [
        "naver/splade-cocondenser-ensembledistil",
        "castorini/monot5-base-msmarco"
      ],
      "weight": 3,
      "datasets": [
        "nanobeir"
      ]
    },
    {
      "id": "retromae_monot5",
      "spec": "RetroMAE top-100 >> text >> monoT5",
      "models": [
        "Shitao/RetroMAE_MSMARCO_distill",
        "castorini/monot5-base-msmarco"
      ],
      "weight": 3,
      "datasets": [
        "nanobeir"
      ]
    },
    {
      "id": "bm25_prf_splade_monot5",
      "spec": "BM25 >> RM3 >> BM25 (k=1000) >> text >> SPLADE as re-scorer >> top-100 >> monoT5",
      "models": [
        "naver/splade-cocondenser-ensembledistil",
        "castorini/monot5-base-msmarco"
      ],
      "weight": 4,
      "datasets": [
        "nanobeir"
      ]
    },
    {
      "id": "bm25_colbert_prf_colbert",
      "spec": "BM25 (k=1000) >> ColBERT re-rank >> ColBERT-PRF (pyterrier_colbert ColbertPRF, rerank mode) >> ColBERT re-score",
      "models": [
        "ColBERT v2 MS MARCO checkpoint (record which one in manifest.json)"
      ],
      "weight": 10,
      "datasets": [
        "nanobeir"
      ]
    },
    {
      "id": "bm25_bert_ce",
      "spec": "BM25 top-100 >> text >> cross-encoder where the query side is '<query> [SEP] <round(bm25 score)>' and the passage is unchanged; zero-shot, no fine-tuning",
      "models": [
        "cross-encoder/ms-marco-MiniLM-L-6-v2"
      ],
      "weight": 2
    }
  ],
  "controls": [
    {
      "id": "bm25_ce",
      "spec": "Harness-side: the condition's bm25 run top-100 >> plain cross-encoder (no score injection); not counted in agent metrics",
      "models": [
        "cross-encoder/ms-marco-MiniLM-L-6-v2"
      ]
    }
  ],
  "datasets": [
